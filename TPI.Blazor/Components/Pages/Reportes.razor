@page "/reportes"
@attribute [Authorize(Roles = "Admin")]
@inject IReporteService ReporteService

<h3>Reportes</h3>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><button class="nav-link @(_tab == 0 ? "active" : "")" @onclick="() => _tab = 0">Ventas por mes</button></li>
    <li class="nav-item"><button class="nav-link @(_tab == 1 ? "active" : "")" @onclick="() => _tab = 1">Productos más vendidos</button></li>
    <li class="nav-item"><button class="nav-link @(_tab == 2 ? "active" : "")" @onclick="() => _tab = 2">Stock bajo</button></li>
</ul>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_tab == 0)
{
    <div class="row g-2 align-items-end mb-3">
        <div class="col-auto"><label class="form-label">Desde</label><input type="date" class="form-control" @bind="_vmDesde" @bind:format="yyyy-MM-dd" /></div>
        <div class="col-auto"><label class="form-label">Hasta</label><input type="date" class="form-control" @bind="_vmHasta" @bind:format="yyyy-MM-dd" /></div>
        <div class="col-auto">
            <label class="form-label">Estado</label>
            <select class="form-select" @bind="_vmEstado">
                <option value="">Sin canceladas</option>
                @foreach (var estado in EstadoVenta.Todos) { <option value="@estado">@estado</option> }
            </select>
        </div>
        <div class="col-auto"><button type="button" class="btn btn-primary" @onclick="GenerarVentasPorMes" disabled="@_cargando">Generar</button></div>
    </div>

    @if (_ventasPorMes is not null)
    {
        <p class="fw-bold">@_ventasPorMes.Sum(v => v.CantidadVentas) ventas | Total: @_ventasPorMes.Sum(v => v.Total).ToString("C2")</p>
        <GraficoBarras Titulo="Ventas por mes (importe total)"
                       Datos="@(_ventasPorMes.Select(v => new PuntoGrafico(v.Etiqueta, v.Total)).ToList())"
                       Formato="@(v => v.ToString("C0"))" />
        <table class="table table-sm">
            <thead><tr><th>Período</th><th>Cantidad de ventas</th><th>Total</th></tr></thead>
            <tbody>
                @foreach (var v in _ventasPorMes)
                {
                    <tr><td>@v.Etiqueta</td><td>@v.CantidadVentas</td><td>@v.Total.ToString("C2")</td></tr>
                }
            </tbody>
        </table>
    }
}
else if (_tab == 1)
{
    <div class="row g-2 align-items-end mb-3">
        <div class="col-auto"><label class="form-label">Desde</label><input type="date" class="form-control" @bind="_mvDesde" @bind:format="yyyy-MM-dd" /></div>
        <div class="col-auto"><label class="form-label">Hasta</label><input type="date" class="form-control" @bind="_mvHasta" @bind:format="yyyy-MM-dd" /></div>
        <div class="col-auto">
            <label class="form-label">Estado</label>
            <select class="form-select" @bind="_mvEstado">
                <option value="">Sin canceladas</option>
                @foreach (var estado in EstadoVenta.Todos) { <option value="@estado">@estado</option> }
            </select>
        </div>
        <div class="col-auto"><label class="form-label">Top</label><input type="number" min="1" max="100" class="form-control" style="width: 90px" @bind="_mvTop" /></div>
        <div class="col-auto"><button type="button" class="btn btn-primary" @onclick="GenerarMasVendidos" disabled="@_cargando">Generar</button></div>
    </div>

    @if (_masVendidos is not null)
    {
        <p class="fw-bold">@_masVendidos.Sum(p => p.UnidadesVendidas) unidades | Monto: @_masVendidos.Sum(p => p.MontoTotal).ToString("C2")</p>
        <GraficoBarras Titulo="@($"Top {_mvTopGenerado} de productos más vendidos (unidades)")"
                       Datos="@(_masVendidos.Select(p => new PuntoGrafico(p.Nombre, p.UnidadesVendidas)).ToList())"
                       Formato="@(v => v.ToString("N0"))" />
        <table class="table table-sm">
            <thead><tr><th>Producto</th><th>Categoría</th><th>Unidades vendidas</th><th>Monto total</th></tr></thead>
            <tbody>
                @foreach (var p in _masVendidos)
                {
                    <tr><td>@p.Nombre</td><td>@p.Categoria</td><td>@p.UnidadesVendidas</td><td>@p.MontoTotal.ToString("C2")</td></tr>
                }
            </tbody>
        </table>
    }
}
else
{
    <div class="row g-2 align-items-end mb-3">
        <div class="col-auto"><label class="form-label">Stock menor o igual a</label><input type="number" min="0" class="form-control" style="width: 110px" @bind="_sbUmbral" /></div>
        <div class="col-auto"><button type="button" class="btn btn-primary" @onclick="GenerarStockBajo" disabled="@_cargando">Generar</button></div>
    </div>

    @if (_stockBajo is not null)
    {
        <p class="fw-bold">@_stockBajo.Count productos con stock menor o igual a @_sbUmbralGenerado</p>
        <table class="table table-sm">
            <thead><tr><th>Producto</th><th>Categoría</th><th>Stock</th></tr></thead>
            <tbody>
                @foreach (var p in _stockBajo)
                {
                    <tr><td>@p.Nombre</td><td>@p.Categoria</td><td>@p.Stock</td></tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private int _tab;
    private bool _cargando;
    private string? _error;

    // Ventas por mes (por defecto: los últimos 12 meses completos, igual que la API)
    private DateTime _vmDesde = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-11);
    private DateTime _vmHasta = DateTime.Today;
    private string _vmEstado = string.Empty;
    private List<VentasPorMesDTO>? _ventasPorMes;

    // Productos más vendidos
    private DateTime _mvDesde = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-11);
    private DateTime _mvHasta = DateTime.Today;
    private string _mvEstado = string.Empty;
    private int _mvTop = 10;
    private int _mvTopGenerado = 10;
    private List<ProductoMasVendidoDTO>? _masVendidos;

    // Stock bajo
    private int _sbUmbral = 5;
    private int _sbUmbralGenerado = 5;
    private List<ProductoStockBajoDTO>? _stockBajo;

    protected override async Task OnInitializedAsync()
    {
        await GenerarVentasPorMes();
        if (_error is null) await GenerarMasVendidos();
        if (_error is null) await GenerarStockBajo();
    }

    private static string? Estado(string valor) => string.IsNullOrWhiteSpace(valor) ? null : valor;

    private async Task GenerarVentasPorMes()
    {
        if (_vmDesde.Date > _vmHasta.Date) { _error = "La fecha 'Desde' no puede ser posterior a 'Hasta'."; return; }
        await Ejecutar(async () =>
            _ventasPorMes = (await ReporteService.VentasPorMesAsync(_vmDesde.Date, _vmHasta.Date, Estado(_vmEstado))).ToList());
    }

    private async Task GenerarMasVendidos()
    {
        if (_mvDesde.Date > _mvHasta.Date) { _error = "La fecha 'Desde' no puede ser posterior a 'Hasta'."; return; }
        if (_mvTop < 1 || _mvTop > 100) { _error = "El 'top' debe estar entre 1 y 100."; return; }
        await Ejecutar(async () =>
        {
            _masVendidos = (await ReporteService.ProductosMasVendidosAsync(
                _mvDesde.Date, _mvHasta.Date, Estado(_mvEstado), null, _mvTop)).ToList();
            _mvTopGenerado = _mvTop;
        });
    }

    private async Task GenerarStockBajo()
    {
        if (_sbUmbral < 0) { _error = "El umbral de stock no puede ser negativo."; return; }
        await Ejecutar(async () =>
        {
            _stockBajo = (await ReporteService.ProductosStockBajoAsync(_sbUmbral, null)).ToList();
            _sbUmbralGenerado = _sbUmbral;
        });
    }

    private async Task Ejecutar(Func<Task> generar)
    {
        _cargando = true;
        _error = null;
        try { await generar(); }
        catch (SesionExpiradaException) { /* el estado de auth cambió: Routes redirige al login */ }
        catch (ApiErrorException ex) { _error = ex.Message; }
        catch (HttpRequestException) { _error = "No se pudo generar el reporte."; }
        finally { _cargando = false; }
    }
}
