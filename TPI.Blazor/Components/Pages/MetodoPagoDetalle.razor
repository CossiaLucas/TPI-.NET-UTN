@page "/metodos-pago/nuevo"
@page "/metodos-pago/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@inject IMetodoPagoService MetodoPagoService
@inject NavigationManager Nav

<h3>@(Id is null ? "Nuevo método de pago" : "Editar método de pago")</h3>

@if (_cargando)
{
    <p>Cargando...</p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <InputText class="form-control" @bind-Value="_model.Nombre" />
            <ValidationMessage For="() => _model.Nombre" />
        </div>
        @if (_error is not null)
        {
            <div class="alert alert-danger">@_error</div>
        }
        <button type="submit" class="btn btn-primary" disabled="@_guardando">Guardar</button>
        <a class="btn btn-secondary" href="/metodos-pago">Cancelar</a>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private readonly MetodoPagoFormModel _model = new();
    private bool _cargando = true;
    private bool _guardando;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Id is not null)
            {
                var dto = await MetodoPagoService.GetByIdAsync(Id.Value);
                if (dto is null) { Nav.NavigateTo("/metodos-pago"); return; }
                _model.Nombre = dto.Nombre;
            }
        }
        catch (SesionExpiradaException) { return; }

        _cargando = false;
    }

    private async Task Guardar()
    {
        _guardando = true;
        _error = null;
        try
        {
            if (Id is null)
            {
                await MetodoPagoService.CreateAsync(new MetodoPagoDTO { Nombre = _model.Nombre });
            }
            else
            {
                var existe = await MetodoPagoService.UpdateAsync(new MetodoPagoDTO { IdMetodoPago = Id.Value, Nombre = _model.Nombre });
                if (!existe) { _error = "El método de pago ya no existe."; return; }
            }

            Nav.NavigateTo("/metodos-pago");
        }
        catch (SesionExpiradaException) { }
        catch (ApiErrorException ex) { _error = ex.Message; }
        catch (HttpRequestException) { _error = "No se pudo guardar el método de pago."; }
        finally { _guardando = false; }
    }

    public class MetodoPagoFormModel
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(100, ErrorMessage = "Máximo 100 caracteres.")]
        public string Nombre { get; set; } = string.Empty;
    }
}
