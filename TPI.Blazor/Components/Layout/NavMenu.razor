@inject ISessionService Sesion
@inject NavigationManager Nav

<AuthorizeView>
    <Authorized>
        <div class="nav-item px-3"><NavLink class="nav-link" href="" Match="NavLinkMatch.All">Inicio</NavLink></div>
        <AuthorizeView Roles="Admin" Context="admin">
            <div class="nav-item px-3"><NavLink class="nav-link" href="categorias">Categorías</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="productos">Productos</NavLink></div>
        </AuthorizeView>
        <div class="nav-item px-3">
            <button class="nav-link btn btn-link" @onclick="CerrarSesion">Cerrar sesión (@context.User.Identity?.Name)</button>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="nav-item px-3"><NavLink class="nav-link" href="login">Iniciar sesión</NavLink></div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private void CerrarSesion()
    {
        Sesion.CerrarSesion();
        Nav.NavigateTo("/login");
    }
}

